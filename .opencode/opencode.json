{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "manager",
  "permission": {
    "bash": {
      "python3 .opencode/skills/sdd/scripts/sdd.py*": "allow",
      "python3 .opencode/skills/project-wiki/scripts/check_wiki.py*": "allow",
      "uv run pytest*": "allow",
      "uv run ruff*": "allow",
      "uv run mypy*": "allow",
      "openspec validate*": "allow",
      "openspec list*": "allow",
      "openspec show*": "allow",
      "openspec status*": "allow",
      "openspec instructions*": "allow",
      "openspec new change*": "allow",
      "openspec archive*": "allow",
      "*": "ask"
    }
  }
}
